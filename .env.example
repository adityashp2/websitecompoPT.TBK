# ========================================================
# KONFIGURASI SUPABASE (PT. Terbang Bersama Kawan)
# ========================================================
# Dapatkan nilai ini dari Dashboard Supabase Anda:
# Buka https://supabase.com -> Project Settings -> API
# ========================================================

# 1. Project URL (contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anon Key (digunakan oleh browser / client publik)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Service Role Secret Key (digunakan oleh server backend untuk akses admin & bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-here
